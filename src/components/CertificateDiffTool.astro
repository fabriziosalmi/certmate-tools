---
import Layout from "~/layouts/Layout.astro";
import PrivacyBadge from "~/components/PrivacyBadge.astro";
import ToolNav from "~/components/ToolNav.astro";
import { getMessages, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const desc =
  locale === "it"
    ? "Confronta due certificati campo per campo nel browser: SAN, validità, chiave, fingerprint. Niente upload."
    : "Diff two certificates field-by-field in your browser: SAN, validity, key, fingerprints. No upload.";
---

<Layout
  title={m.certificateDiffTitle}
  description={desc}
  keywords={["certificate diff", "compare certificates", "cert diff", "confronto certificati"]}
  compact
>
  <div class="flex-1 flex flex-col items-stretch justify-start md:justify-center px-4 py-6 md:py-10">
    <div class="w-full max-w-3xl mx-auto">
      <ToolNav locale={locale} currentSlug="certificate-diff" />
      <header class="mb-5">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
          {m.certificateDiffTitle}
        </h1>
        <p class="mt-1.5 text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {m.certificateDiffTagline}
        </p>
        <div class="mt-3"><PrivacyBadge locale={locale} variant="inline" /></div>
      </header>

      <div class="grid md:grid-cols-2 gap-4">
        <div class:list={["rounded-2xl border shadow-sm overflow-hidden", "bg-white border-zinc-200", "dark:bg-zinc-900 dark:border-zinc-800"]}>
          <div class="border-b px-4 py-2.5 text-xs font-medium bg-zinc-50/60 border-zinc-100 text-zinc-500 dark:bg-zinc-900/80 dark:border-zinc-800 dark:text-zinc-400">Certificate A</div>
          <textarea id="diff-a" rows="8" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" placeholder="-----BEGIN CERTIFICATE-----..." class:list={["mono w-full resize-y border-0 px-4 py-3 text-base sm:text-sm leading-relaxed min-h-36 focus:outline-none focus:ring-0", "bg-white text-zinc-900 placeholder:text-zinc-400", "dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600"]}></textarea>
        </div>
        <div class:list={["rounded-2xl border shadow-sm overflow-hidden", "bg-white border-zinc-200", "dark:bg-zinc-900 dark:border-zinc-800"]}>
          <div class="border-b px-4 py-2.5 text-xs font-medium bg-zinc-50/60 border-zinc-100 text-zinc-500 dark:bg-zinc-900/80 dark:border-zinc-800 dark:text-zinc-400">Certificate B</div>
          <textarea id="diff-b" rows="8" spellcheck="false" autocomplete="off" autocapitalize="off" autocorrect="off" placeholder="-----BEGIN CERTIFICATE-----..." class:list={["mono w-full resize-y border-0 px-4 py-3 text-base sm:text-sm leading-relaxed min-h-36 focus:outline-none focus:ring-0", "bg-white text-zinc-900 placeholder:text-zinc-400", "dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600"]}></textarea>
        </div>
      </div>

      <div class="mt-4 flex items-center gap-3 flex-wrap">
        <button type="button" data-action="diff" class:list={["inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-md px-5 py-3 text-sm font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed", "bg-zinc-900 text-white hover:bg-zinc-800", "dark:bg-brand-500 dark:text-zinc-50 dark:hover:bg-brand-400"]}>{m.decodeButton}</button>
        <button type="button" data-action="clear" class="text-xs font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">{m.clear}</button>
        <p id="status" role="status" aria-live="polite" class="w-full sm:w-auto text-xs sm:text-sm leading-relaxed text-zinc-500 dark:text-zinc-400"></p>
      </div>

      <div id="error" role="alert" class:list={["mt-5 hidden rounded-lg border px-4 py-3 text-sm", "bg-red-50 border-red-200 text-red-900", "dark:bg-red-950/40 dark:border-red-900/60 dark:text-red-200"]}></div>
      <div id="result" class="mt-5"></div>
    </div>
  </div>
</Layout>

<script>
  import { diffCertificates } from "~/lib/cert-diff";
  import { MAX_INPUT_BYTES } from "~/lib/util";
  import { el, mount } from "~/lib/dom";
  import { detectLocale, getMessages } from "~/i18n";

  const locale = detectLocale(location.pathname);
  const m = getMessages(locale);

  const $a = document.getElementById("diff-a") as HTMLTextAreaElement;
  const $b = document.getElementById("diff-b") as HTMLTextAreaElement;
  const $status = document.getElementById("status") as HTMLElement;
  const $error = document.getElementById("error") as HTMLElement;
  const $result = document.getElementById("result") as HTMLElement;
  const $btn = document.querySelector('[data-action="diff"]') as HTMLButtonElement;

  let busy = false;

  function showError(msg: string): void {
    $error.textContent = msg;
    $error.classList.remove("hidden");
    $status.textContent = "";
  }

  async function run(): Promise<void> {
    if (busy) return;
    $error.classList.add("hidden");
    if (!$a.value.trim() || !$b.value.trim()) {
      $status.textContent = m.inputEmpty;
      return;
    }
    if ($a.value.length > MAX_INPUT_BYTES || $b.value.length > MAX_INPUT_BYTES) {
      showError(m.inputTooLarge);
      return;
    }
    busy = true;
    $btn.disabled = true;
    $status.textContent = m.decodingButton;
    try {
      const r = await diffCertificates($a.value, $b.value);
      if (!r.ok) {
        showError(r.error);
        return;
      }
      const changed = r.rows.filter((x) => !x.same).length;
      $status.textContent = `${r.rows.length - changed}/${r.rows.length} fields identical.`;
      const headerRow = el(
        "div",
        { class: "grid grid-cols-[7rem_1fr_1fr] gap-2 px-3 py-2 text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400" },
        el("span", null, "Field"),
        el("span", { class: "mono break-all" }, r.cnA.slice(0, 40)),
        el("span", { class: "mono break-all" }, r.cnB.slice(0, 40))
      );
      mount(
        $result,
        el(
          "div",
          { class: "rounded-lg border border-zinc-200 bg-white dark:bg-zinc-900/40 dark:border-zinc-800 overflow-hidden" },
          headerRow,
          r.rows.map((x) =>
            el(
              "div",
              { class: `grid grid-cols-[7rem_1fr_1fr] gap-2 px-3 py-2 text-xs border-t border-zinc-100 dark:border-zinc-800 ${x.same ? "" : "bg-amber-50/60 dark:bg-amber-950/20"}` },
              el("span", { class: "font-semibold text-zinc-700 dark:text-zinc-300" }, `${x.same ? "·" : "≠"} ${x.field}`),
              el("span", { class: "mono break-all text-zinc-900 dark:text-zinc-100" }, x.a.slice(0, 160)),
              el("span", { class: "mono break-all text-zinc-900 dark:text-zinc-100" }, x.b.slice(0, 160))
            )
          )
        )
      );
    } finally {
      busy = false;
      $btn.disabled = false;
    }
  }

  $btn.addEventListener("click", () => void run());
  document.querySelector('[data-action="clear"]')?.addEventListener("click", () => {
    $a.value = "";
    $b.value = "";
    $error.classList.add("hidden");
    $status.textContent = "";
    mount($result, null);
    $a.focus();
  });
</script>
