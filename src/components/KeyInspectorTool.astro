---
import Layout from "~/layouts/Layout.astro";
import PrivacyBadge from "~/components/PrivacyBadge.astro";
import ToolNav from "~/components/ToolNav.astro";
import { getMessages, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const desc =
  locale === "it"
    ? "Ispeziona chiavi RSA/EC nel browser: algoritmo, dimensione, curva, thumbprint SPKI. Niente upload."
    : "Inspect RSA/EC keys in your browser: algorithm, size, curve, SPKI thumbprint. No upload.";
---

<Layout
  title={m.keyInspectorTitle}
  description={desc}
  keywords={["rsa key inspector", "ec key inspector", "inspect private key", "spki", "ispezionare chiave privata"]}
  compact
>
  <div class="flex-1 flex flex-col items-stretch justify-start md:justify-center px-4 py-6 md:py-10">
    <div class="w-full max-w-3xl mx-auto">
      <ToolNav locale={locale} currentSlug="key-inspector" />
      <header class="mb-5">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
          {m.keyInspectorTitle}
        </h1>
        <p class="mt-1.5 text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {m.keyInspectorTagline}
        </p>
        <div class="mt-3"><PrivacyBadge locale={locale} variant="inline" /></div>
      </header>

      <div class:list={["rounded-2xl border shadow-sm overflow-hidden", "bg-white border-zinc-200", "dark:bg-zinc-900 dark:border-zinc-800"]}>
        <div class:list={["flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2.5", "bg-zinc-50/60 border-zinc-100", "dark:bg-zinc-900/80 dark:border-zinc-800"]}>
          <div class="text-xs font-medium text-zinc-500 dark:text-zinc-400">PRIVATE KEY · PUBLIC KEY · CERTIFICATE</div>
          <button type="button" data-action="clear" class="text-xs font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">{m.clear}</button>
        </div>
        <textarea
          id="ki-input"
          rows="8"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          maxlength="2097152"
          placeholder="-----BEGIN PRIVATE KEY-----..."
          class:list={["mono w-full resize-y border-0 px-4 py-3 text-base sm:text-sm leading-relaxed min-h-40 focus:outline-none focus:ring-0", "bg-white text-zinc-900 placeholder:text-zinc-400", "dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600"]}
        ></textarea>
      </div>

      <div class="mt-4 flex items-center gap-3 flex-wrap">
        <button
          type="button"
          data-action="inspect"
          class:list={["inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-md px-5 py-3 text-sm font-semibold transition-colors disabled:opacity-50 disabled:cursor-not-allowed", "bg-zinc-900 text-white hover:bg-zinc-800", "dark:bg-brand-500 dark:text-zinc-50 dark:hover:bg-brand-400"]}
        >{m.decodeButton}</button>
        <p id="status" role="status" aria-live="polite" class="w-full sm:w-auto text-xs sm:text-sm leading-relaxed text-zinc-500 dark:text-zinc-400"></p>
      </div>

      <div id="error" role="alert" class:list={["mt-5 hidden rounded-lg border px-4 py-3 text-sm", "bg-red-50 border-red-200 text-red-900", "dark:bg-red-950/40 dark:border-red-900/60 dark:text-red-200"]}></div>
      <div id="result" class="mt-5"></div>
    </div>
  </div>
</Layout>

<script>
  import { inspectKey } from "~/lib/key-inspector";
  import { el, mount } from "~/lib/dom";
  import { detectLocale, getMessages } from "~/i18n";

  const locale = detectLocale(location.pathname);
  const m = getMessages(locale);

  const $input = document.getElementById("ki-input") as HTMLTextAreaElement;
  const $status = document.getElementById("status") as HTMLElement;
  const $error = document.getElementById("error") as HTMLElement;
  const $result = document.getElementById("result") as HTMLElement;
  const $btn = document.querySelector('[data-action="inspect"]') as HTMLButtonElement;

  let busy = false;

  function showError(msg: string): void {
    $error.textContent = msg;
    $error.classList.remove("hidden");
    $status.textContent = "";
  }

  function row(k: string, v: string): HTMLElement {
    return el(
      "div",
      { class: "flex items-baseline justify-between gap-4 py-1.5 border-b border-zinc-100 dark:border-zinc-800 last:border-0" },
      el("dt", { class: "text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400 shrink-0" }, k),
      el("dd", { class: "text-sm mono text-right break-all" }, v)
    );
  }

  async function run(): Promise<void> {
    if (busy) return;
    $error.classList.add("hidden");
    if (!$input.value.trim()) {
      $status.textContent = m.inputEmpty;
      return;
    }
    busy = true;
    $btn.disabled = true;
    $status.textContent = m.decodingButton;
    try {
      const r = await inspectKey($input.value);
      if (!r.ok) {
        mount($result, null);
        showError(r.error);
        return;
      }
      const k = r.key;
      $status.textContent = m.decodedSuccess(1);
      mount(
        $result,
        el(
          "div",
          { class: "rounded-lg border border-zinc-200 bg-white p-5 dark:bg-zinc-900/40 dark:border-zinc-800" },
          el(
            "dl",
            null,
            row("Type", `${k.kind} (${k.source})`),
            row(m.commonAlgorithm, k.algorithm),
            k.keySize ? row(m.commonKeySize, `${k.keySize} bits`) : null,
            k.namedCurve ? row(m.commonCurve, k.namedCurve) : null,
            k.exponent ? row("Exponent (e)", k.exponent) : null,
            k.certCommonName ? row(m.commonCommonName, k.certCommonName) : null,
            row(m.commonSpkiHash, k.spkiSha256)
          )
        )
      );
    } finally {
      busy = false;
      $btn.disabled = false;
    }
  }

  $btn.addEventListener("click", () => void run());
  $input.addEventListener("paste", () => {
    setTimeout(() => {
      if ($input.value.trim()) void run();
    }, 0);
  });
  document.querySelector('[data-action="clear"]')?.addEventListener("click", () => {
    $input.value = "";
    $error.classList.add("hidden");
    $status.textContent = "";
    mount($result, null);
    $input.focus();
  });
</script>
