---
import Layout from "~/layouts/Layout.astro";
import PrivacyBadge from "~/components/PrivacyBadge.astro";
import ToolNav from "~/components/ToolNav.astro";
import { getMessages, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);
const desc =
  locale === "it"
    ? "Valida un CSV di inventario certificati nel browser: hostname, date, scadenze. Niente upload."
    : "Validate a certificate inventory CSV in your browser: hostnames, dates, expirations. No upload.";
---

<Layout
  title={m.inventoryValidatorTitle}
  description={desc}
  keywords={["certificate inventory", "csv validator", "expiry inventory", "inventario certificati csv"]}
  compact
>
  <div class="flex-1 flex flex-col items-stretch justify-start md:justify-center px-4 py-6 md:py-10">
    <div class="w-full max-w-3xl mx-auto">
      <ToolNav locale={locale} currentSlug="inventory-validator" />
      <header class="mb-5">
        <h1 class="text-2xl md:text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
          {m.inventoryValidatorTitle}
        </h1>
        <p class="mt-1.5 text-zinc-600 dark:text-zinc-400 leading-relaxed">
          {m.inventoryValidatorTagline}
        </p>
        <div class="mt-3"><PrivacyBadge locale={locale} variant="inline" /></div>
      </header>

      <div class:list={["rounded-2xl border shadow-sm overflow-hidden", "bg-white border-zinc-200", "dark:bg-zinc-900 dark:border-zinc-800"]}>
        <div class:list={["flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2.5", "bg-zinc-50/60 border-zinc-100", "dark:bg-zinc-900/80 dark:border-zinc-800"]}>
          <div class="text-xs font-medium text-zinc-500 dark:text-zinc-400">hostname,not_after</div>
          <div class="flex items-center gap-2 text-xs">
            <button type="button" data-action="sample" class="font-medium text-brand-700 hover:text-brand-800 dark:text-brand-400 dark:hover:text-brand-300">{m.tryWithSample}</button>
            <span class="text-zinc-300 dark:text-zinc-700">·</span>
            <button type="button" data-action="clear" class="font-medium text-zinc-500 hover:text-zinc-900 dark:text-zinc-400 dark:hover:text-zinc-100">{m.clear}</button>
          </div>
        </div>
        <textarea
          id="inv-input"
          rows="8"
          spellcheck="false"
          autocomplete="off"
          autocapitalize="off"
          autocorrect="off"
          maxlength="2097152"
          placeholder="hostname,not_after&#10;example.com,2026-12-01"
          class:list={["mono w-full resize-y border-0 px-4 py-3 text-base sm:text-sm leading-relaxed min-h-40 focus:outline-none focus:ring-0", "bg-white text-zinc-900 placeholder:text-zinc-400", "dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600"]}
        ></textarea>
      </div>

      <div class="mt-4 flex items-center gap-3 flex-wrap">
        <button type="button" data-action="validate" class:list={["inline-flex w-full sm:w-auto justify-center items-center gap-2 rounded-md px-5 py-3 text-sm font-semibold transition-colors", "bg-zinc-900 text-white hover:bg-zinc-800", "dark:bg-brand-500 dark:text-zinc-50 dark:hover:bg-brand-400"]}>{m.decodeButton}</button>
        <p id="status" role="status" aria-live="polite" class="w-full sm:w-auto text-xs sm:text-sm leading-relaxed text-zinc-500 dark:text-zinc-400"></p>
      </div>

      <div id="error" role="alert" class:list={["mt-5 hidden rounded-lg border px-4 py-3 text-sm", "bg-red-50 border-red-200 text-red-900", "dark:bg-red-950/40 dark:border-red-900/60 dark:text-red-200"]}></div>
      <div id="result" class="mt-5"></div>
    </div>
  </div>
</Layout>

<script>
  import { validateInventoryCsv, SAMPLE_INVENTORY_CSV } from "~/lib/inventory";
  import { el, mount } from "~/lib/dom";
  import { detectLocale, getMessages } from "~/i18n";

  const locale = detectLocale(location.pathname);
  const m = getMessages(locale);

  const $input = document.getElementById("inv-input") as HTMLTextAreaElement;
  const $status = document.getElementById("status") as HTMLElement;
  const $error = document.getElementById("error") as HTMLElement;
  const $result = document.getElementById("result") as HTMLElement;

  function showError(msg: string): void {
    $error.textContent = msg;
    $error.classList.remove("hidden");
    $status.textContent = "";
  }

  function run(): void {
    $error.classList.add("hidden");
    if (!$input.value.trim()) {
      $status.textContent = m.inputEmpty;
      return;
    }
    const r = validateInventoryCsv($input.value);
    if (!r.ok) {
      mount($result, null);
      showError(r.error);
      return;
    }
    const s = r.summary;
    $status.textContent = m.decodedSuccess(s.rows);
    const bad = r.rows.filter((x) => x.issues.length > 0).slice(0, 50);
    mount(
      $result,
      el(
        "div",
        { class: "space-y-3" },
        el(
          "div",
          { class: "grid grid-cols-2 sm:grid-cols-4 gap-2" },
          [
            ["Rows", String(s.rows)],
            ["With expiry", String(s.withExpiry)],
            ["Expired", String(s.expired)],
            ["Invalid", String(s.invalid)],
          ].map(([k, v]) =>
            el(
              "div",
              { class: "rounded-lg border border-zinc-200 bg-white p-3 dark:bg-zinc-900/40 dark:border-zinc-800" },
              el("div", { class: "text-xs font-semibold uppercase tracking-wider text-zinc-500" }, k),
              el("div", { class: "text-xl font-bold mono" }, v)
            )
          )
        ),
        bad.length
          ? el(
              "div",
              { class: "rounded-lg border border-zinc-200 bg-white dark:bg-zinc-900/40 dark:border-zinc-800 overflow-hidden" },
              bad.map((x) =>
                el(
                  "div",
                  { class: "px-3 py-2 text-xs border-t border-zinc-100 dark:border-zinc-800 first:border-0" },
                  el("span", { class: "mono font-semibold" }, `L${x.line} ${x.hostname || "(empty)"} `),
                  el("span", { class: "text-amber-800 dark:text-amber-200" }, `: ${x.issues.join("; ")}`)
                )
              )
            )
          : el("p", { class: "text-sm text-emerald-700 dark:text-emerald-300 font-semibold" }, "✓ all rows valid")
      )
    );
  }

  document.querySelector('[data-action="validate"]')?.addEventListener("click", run);
  document.querySelector('[data-action="sample"]')?.addEventListener("click", () => {
    $input.value = SAMPLE_INVENTORY_CSV;
    run();
  });
  document.querySelector('[data-action="clear"]')?.addEventListener("click", () => {
    $input.value = "";
    $error.classList.add("hidden");
    $status.textContent = "";
    mount($result, null);
    $input.focus();
  });
</script>
