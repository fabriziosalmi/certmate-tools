---
import Layout from "~/layouts/Layout.astro";
import ToolCard from "~/components/ToolCard.astro";
import {
  internalTools,
  externalTools,
  type Category,
  type InternalTool,
  type ExternalTool,
} from "~/data/tools";
import { getMessages, localizedPath, toolLabels, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const m = getMessages(locale);

const catLabels: Record<Category, { label: string; blurb: string }> = {
  decode: { label: m.catDecodeLabel, blurb: m.catDecodeBlurb },
  validate: { label: m.catValidateLabel, blurb: m.catValidateBlurb },
  inspect: { label: m.catInspectLabel, blurb: m.catInspectBlurb },
  monitor: { label: m.catMonitorLabel, blurb: m.catMonitorBlurb },
  acme: { label: m.catAcmeLabel, blurb: m.catAcmeBlurb },
  compliance: { label: m.catComplianceLabel, blurb: m.catComplianceBlurb },
};

const liveCount = internalTools.filter((t) => t.status === "live").length;
const internalCategoryOrder: Category[] = [
  "decode",
  "validate",
  "monitor",
  "inspect",
  "acme",
  "compliance",
];
const externalCategoryOrder: Category[] = [
  "decode",
  "validate",
  "inspect",
  "monitor",
  "acme",
  "compliance",
];

const groupedInternal = internalCategoryOrder
  .map((cat) => ({
    cat,
    tools: internalTools.filter((t) => t.category === cat),
  }))
  .filter((g) => g.tools.length > 0);

const groupedExternal = externalCategoryOrder
  .map((cat) => ({
    cat,
    tools: externalTools.filter((t) => t.category === cat),
  }))
  .filter((g) => g.tools.length > 0);

const seoDescription =
  locale === "it"
    ? "Strumenti online gratuiti e privacy-first per certificati TLS, CSR, ACME, DNS e compliance EU. Tutto nel tuo browser — niente upload, niente tracking."
    : "Free, privacy-first online tools for TLS certificates, CSRs, ACME, DNS and EU compliance. Everything runs in your browser — no uploads, no tracking.";

const siteBase = "https://tools.certmate.org";
const liveInternal = internalTools.filter((t) => t.status === "live");

function cardSearchInternal(t: InternalTool): string {
  const labels = toolLabels(m, t.slug, { title: t.title, tagline: t.tagline });
  return `${labels.title} ${labels.tagline} ${t.keywords.join(" ")}`.toLowerCase();
}

function cardSearchExternal(t: ExternalTool): string {
  return `${t.name} ${t.why}`.toLowerCase();
}

// "&" is rewritten for the JSON-LD block only: if Astro HTML-escapes the
// interpolated string, "&amp;" would corrupt the structured data while
// JSON.parse still succeeds — silently wrong SEO. "and" keeps it valid.
// "<" is unicode-escaped so no string can ever form a "</script>" breakout.
function plain(s: string): string {
  return s.replace(/&/g, "and");
}

const jsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      name: "CertMate Tools",
      url: siteBase + localizedPath(locale, "/"),
      description: plain(seoDescription),
      inLanguage: locale,
    },
    {
      "@type": "ItemList",
      itemListElement: liveInternal.map((t, i) => {
        const labels = toolLabels(m, t.slug, {
          title: t.title,
          tagline: t.tagline,
        });
        return {
          "@type": "ListItem",
          position: i + 1,
          item: {
            "@type": "SoftwareApplication",
            name: plain(labels.title),
            url: siteBase + localizedPath(locale, `/${t.slug}/`),
            description: plain(labels.tagline),
            applicationCategory: "SecurityApplication",
            operatingSystem: "Any (Web)",
            offers: { "@type": "Offer", price: "0" },
          },
        };
      }),
    },
    {
      "@type": "FAQPage",
      mainEntity: m.homeFaq.map((f) => ({
        "@type": "Question",
        name: plain(f.q),
        acceptedAnswer: { "@type": "Answer", text: plain(f.a) },
      })),
    },
  ],
}).replace(/</g, "\\u003c");
---

<Layout
  title="CertMate Tools"
  description={seoDescription}
  keywords={[
    "ssl tools",
    "certificate decoder",
    "csr decoder",
    "csr generator",
    "fingerprint calculator",
    "pem to der",
    "certificate renewal calculator",
    "certificate diff",
    "rsa key inspector",
    "ssl checker",
    "tls tools",
    "acme tools",
    "nis2 tls",
    "decoder certificati",
    "generatore csr",
    "calcolatore fingerprint",
    "tools certificati ssl",
  ]}
>
  <script type="application/ld+json" set:html={jsonLd} /> {/* innerhtml-ok: static build-time JSON-LD (own strings only, "<" unicode-escaped, no user input) */}
  <section
    class:list={[
      "border-b",
      "border-zinc-100 bg-gradient-to-b from-brand-50/60 to-white",
      "dark:border-zinc-800 dark:from-brand-900/20 dark:to-zinc-950",
    ]}
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-5 py-12 md:py-24">
      <div class="max-w-3xl">
        <span
          class:list={[
            "inline-flex items-center gap-1.5 rounded-full ring-1 px-3 py-1 text-xs font-medium",
            "bg-white ring-zinc-200 text-zinc-700",
            "dark:bg-zinc-900 dark:ring-zinc-800 dark:text-zinc-300",
          ]}
        >
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
          {m.homeBadge(liveCount)}
        </span>
        <h1
          class="mt-5 text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight leading-[1.1] md:leading-[1.05] text-zinc-900 dark:text-zinc-50"
        >
          {m.homeHeadlineL1}
          <br class="hidden md:block" />
          {m.homeHeadlineL2a}{" "}
          <span class="text-brand-700 dark:text-brand-400">{m.homeHeadlineL2b}</span>.
        </h1>
        <p class="mt-5 text-base sm:text-lg leading-relaxed max-w-2xl text-zinc-600 dark:text-zinc-300">
          {m.homeIntro}
        </p>

        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href="#tools"
            class:list={[
              "inline-flex items-center gap-2 rounded-md px-4 py-2.5 text-sm font-medium transition-colors",
              "bg-zinc-900 text-white hover:bg-zinc-800",
              "dark:bg-zinc-100 dark:text-zinc-900 dark:hover:bg-white",
            ]}
          >
            {m.homeCtaBrowse}
          </a>
          <a
            href={localizedPath(locale, "/certificate-decoder/")}
            class:list={[
              "inline-flex items-center gap-2 rounded-md px-4 py-2.5 text-sm font-medium ring-1 transition-colors",
              "bg-white text-zinc-900 ring-zinc-300 hover:bg-zinc-50",
              "dark:bg-zinc-900 dark:text-zinc-100 dark:ring-zinc-700 dark:hover:bg-zinc-800",
            ]}
          >
            {m.homeCtaTry}
          </a>
        </div>
      </div>
    </div>
  </section>

  <section
    aria-label={m.trustStripTitle}
    class:list={[
      "border-b",
      "border-zinc-100 bg-white",
      "dark:border-zinc-800 dark:bg-zinc-950",
    ]}
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-5 py-6">
      <p
        class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400"
      >
        {m.trustStripTitle}
      </p>
      <ul class="mt-3 grid gap-3 sm:grid-cols-3">
        <li>
          <a
            href={localizedPath(locale, "/privacy/")}
            class:list={[
              "block rounded-xl border p-4 transition-colors",
              "border-zinc-200 hover:border-brand-400",
              "dark:border-zinc-800 dark:hover:border-brand-600",
            ]}
          >
            <span class="block text-sm font-semibold text-zinc-900 dark:text-zinc-50">
              {m.trustPrivacyLabel} →
            </span>
            <span class="mt-1 block text-sm text-zinc-600 dark:text-zinc-400">
              {m.trustPrivacyBlurb}
            </span>
          </a>
        </li>
        <li>
          <a
            href="https://github.com/fabriziosalmi/certmate-tools/blob/main/scripts/check-no-network.mjs"
            target="_blank"
            rel="noopener"
            class:list={[
              "block rounded-xl border p-4 transition-colors",
              "border-zinc-200 hover:border-brand-400",
              "dark:border-zinc-800 dark:hover:border-brand-600",
            ]}
          >
            <span class="block text-sm font-semibold text-zinc-900 dark:text-zinc-50">
              {m.trustGateLabel} →
            </span>
            <span class="mt-1 block text-sm text-zinc-600 dark:text-zinc-400">
              {m.trustGateBlurb}
            </span>
          </a>
        </li>
        <li>
          <a
            href="https://github.com/fabriziosalmi/certmate-tools"
            target="_blank"
            rel="noopener"
            class:list={[
              "block rounded-xl border p-4 transition-colors",
              "border-zinc-200 hover:border-brand-400",
              "dark:border-zinc-800 dark:hover:border-brand-600",
            ]}
          >
            <span class="block text-sm font-semibold text-zinc-900 dark:text-zinc-50">
              {m.trustSourceLabel} →
            </span>
            <span class="mt-1 block text-sm text-zinc-600 dark:text-zinc-400">
              {m.trustSourceBlurb}
            </span>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <section id="tools" class="mx-auto max-w-6xl px-4 sm:px-5 py-14 sm:py-16">
    <div class="flex items-baseline justify-between flex-wrap gap-3 mb-2">
      <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
        {m.homeOurTools}
      </h2>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">
        {m.homeOurToolsClaim}
      </p>
    </div>
    <p class="text-zinc-600 max-w-2xl mb-6 dark:text-zinc-400">
      {m.homeOurToolsLead}
    </p>

    <nav aria-label={m.homeOurTools} class="mb-6 flex flex-wrap gap-2">
      {
        groupedInternal.map(({ cat }) => (
          <a
            href={`#tools-${cat}`}
            class:list={[
              "rounded-full px-3 py-1.5 text-xs font-medium ring-1 transition-colors",
              "bg-white text-zinc-600 ring-zinc-200 hover:ring-brand-400 hover:text-zinc-900",
              "dark:bg-zinc-900 dark:text-zinc-400 dark:ring-zinc-800 dark:hover:ring-brand-600 dark:hover:text-zinc-100",
            ]}
          >
            {catLabels[cat].label}
          </a>
        ))
      }
    </nav>

    <div class="mb-8 flex flex-col sm:flex-row sm:items-center gap-3">
      <input
        id="tool-filter"
        type="search"
        autocomplete="off"
        placeholder={m.homeFilterPlaceholder}
        aria-label={m.homeFilterPlaceholder}
        class:list={[
          "w-full sm:max-w-sm rounded-md border px-3 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-brand-400/40",
          "border-zinc-200 bg-white text-zinc-900 placeholder:text-zinc-400",
          "dark:border-zinc-800 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder:text-zinc-600",
        ]}
      />
      <p
        id="tool-filter-status"
        role="status"
        aria-live="polite"
        class="text-sm text-zinc-500 dark:text-zinc-400"
      >
      </p>
    </div>

    <div class="space-y-12">
      {
        groupedInternal.map(({ cat, tools }) => (
          <div id={`tools-${cat}`} data-category-section>
            <div class="mb-4 flex flex-col sm:flex-row sm:items-baseline gap-1.5 sm:gap-3">
              <h3 class="text-sm font-semibold uppercase tracking-wider text-brand-700 dark:text-brand-400">
                {catLabels[cat].label}
              </h3>
              <p class="text-sm text-zinc-500 dark:text-zinc-400">
                {catLabels[cat].blurb}
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {tools.map((t) => (
                <div data-tool-card data-search={cardSearchInternal(t)}>
                  <ToolCard tool={t} locale={locale} />
                </div>
              ))}
            </div>
            <p data-filter-empty hidden class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">
              {m.homeFilterEmpty}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section
    class:list={[
      "border-t",
      "border-zinc-100 bg-zinc-50/60",
      "dark:border-zinc-800 dark:bg-zinc-950/60",
    ]}
  >
    <div class="mx-auto max-w-6xl px-5 py-16">
      <div class="flex items-baseline justify-between flex-wrap gap-3 mb-2">
        <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
          {m.homeExternal}
        </h2>
        <p class="text-sm text-zinc-500 dark:text-zinc-400">
          {m.homeExternalCurated}
        </p>
      </div>
      <p class="text-zinc-600 max-w-2xl mb-10 dark:text-zinc-400">
        {m.homeExternalLead}
      </p>

    <div class="space-y-12">
        {
          groupedExternal.map(({ cat, tools }) => (
            <div data-category-section>
              <div class="mb-4">
                <h3 class="text-sm font-semibold uppercase tracking-wider text-zinc-700 dark:text-zinc-300">
                  {catLabels[cat].label}
                </h3>
              </div>
              <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                {tools.map((t) => (
                  <div data-tool-card data-search={cardSearchExternal(t)}>
                    <ToolCard tool={t} locale={locale} />
                  </div>
                ))}
              </div>
              <p data-filter-empty hidden class="mt-4 text-sm text-zinc-500 dark:text-zinc-400">
                {m.homeFilterEmpty}
              </p>
            </div>
          ))
        }
    </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-5 py-16 sm:py-20">
    <h2 class="text-2xl font-bold tracking-tight text-zinc-900 dark:text-zinc-50">
      {m.homeFaqTitle}
    </h2>
    <p class="mt-2 text-zinc-600 max-w-2xl dark:text-zinc-400">
      {m.homeFaqLead}
    </p>
    <div class="mt-8 grid gap-4 md:grid-cols-2">
      {
        m.homeFaq.map((f) => (
          <div
            class:list={[
              "rounded-xl border p-5",
              "border-zinc-200 bg-white",
              "dark:border-zinc-800 dark:bg-zinc-900/40",
            ]}
          >
            <h3 class="font-semibold text-zinc-900 dark:text-zinc-50">
              {f.q}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-zinc-600 dark:text-zinc-400">
              {f.a}
            </p>
          </div>
        ))
      }
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 sm:px-5 py-16 sm:py-20">
    <div
      class:list={[
        "rounded-2xl p-6 sm:p-10 md:p-14 flex flex-col md:flex-row items-start md:items-center justify-between gap-6 text-white",
        "bg-zinc-900",
        "dark:bg-gradient-to-br dark:from-zinc-900 dark:to-zinc-800",
      ]}
    >
      <div class="max-w-xl">
        <h3 class="text-2xl font-bold tracking-tight">
          {m.homeBottomTitle}
        </h3>
        <p class="mt-3 text-zinc-300 leading-relaxed">
          {m.homeBottomBody}
          {" "}
          <a
            href="https://cabforum.org/2025/04/11/ballot-sc081v3-introduce-schedule-of-reducing-validity-and-data-reuse-periods/"
            target="_blank"
            rel="noopener"
            class="underline decoration-zinc-500 hover:decoration-white"
            >SC-081v3 ↗</a
          >
        </p>
      </div>
      <a
        href="https://github.com/fabriziosalmi/certmate"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 rounded-md bg-white text-zinc-900 px-5 py-3 font-medium hover:bg-zinc-100 transition-colors shrink-0"
      >
        {m.homeBottomCta}
      </a>
    </div>
  </section>
</Layout>

<script>
  import { detectLocale, getMessages } from "~/i18n";

  // Client-side tool filter. Pure DOM hide/show over the pre-rendered cards:
  // no fetch, no network, nothing to leak.
  const locale = detectLocale(location.pathname);
  const m = getMessages(locale);

  const $q = document.getElementById("tool-filter") as HTMLInputElement | null;
  const $status = document.getElementById("tool-filter-status");

  function applyFilter(): void {
    if (!$q || !$status) return;
    const q = $q.value.trim().toLowerCase();
    let shown = 0;
    let total = 0;
    document.querySelectorAll("[data-category-section]").forEach((sec) => {
      let secShown = 0;
      let secTotal = 0;
      sec.querySelectorAll("[data-tool-card]").forEach((card) => {
        secTotal += 1;
        total += 1;
        const hit =
          q === "" || (card.getAttribute("data-search") ?? "").includes(q);
        card.classList.toggle("hidden", !hit);
        if (hit) {
          secShown += 1;
          shown += 1;
        }
      });
      sec.classList.toggle("hidden", secTotal > 0 && secShown === 0);
      sec
        .querySelectorAll("[data-filter-empty]")
        .forEach((p) => p.classList.toggle("hidden", secShown !== 0));
    });
    $status.textContent = q === "" ? "" : m.homeFilterStatus(shown, total);
  }

  $q?.addEventListener("input", applyFilter);
</script>
